# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
.next/
out/
build/
next-env.d.ts
.vercel

# env — .env.example is the only env file that may be tracked.
# Broad glob on purpose: a Finder duplicate like ".env copy.example" is not
# matched by ".env.local" or ".env.*.local" and would otherwise be committable.
.env*
!.env.example

# supabase local state
supabase/.branches
supabase/.temp
supabase/.env

# personal data — resumes used in testing must never be committed
*.pdf
*.docx
*.doc
/private/

# os / editor
.DS_Store
*.pem
.vscode/
.idea/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
*.tsbuildinfo
coverage/

# generated from design/tokens.json — tokens.json is the only tracked source
# of design values, which is what makes the no-raw-values rule greppable
src/styles/tokens.generated.css
