{
  "name": "monadic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run tokens",
    "dev": "NODE_OPTIONS=--experimental-websocket next dev",
    "prebuild": "npm run tokens",
    "build": "NODE_OPTIONS=--experimental-websocket next build",
    "start": "NODE_OPTIONS=--experimental-websocket next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "tokens": "tsx scripts/build-tokens.ts",
    "types": "supabase gen types typescript --linked --schema public > src/lib/supabase/types.ts",
    "seed:user": "NODE_OPTIONS=--experimental-websocket tsx scripts/seed-user.ts",
    "check:rls": "NODE_OPTIONS=--experimental-websocket tsx scripts/check-rls.ts",
    "resolve": "NODE_OPTIONS=--experimental-websocket tsx scripts/resolve.ts",
    "ingest": "NODE_OPTIONS=--experimental-websocket tsx scripts/ingest.ts",
    "backfill": "NODE_OPTIONS=--experimental-websocket tsx scripts/backfill.ts",
    "logos": "NODE_OPTIONS=--experimental-websocket tsx scripts/logos.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.10"
  }
}
