# monadic — environment contract
#
# Copy to .env.local and fill in. .env.local is gitignored and holds real
# secrets; this file must never contain a real credential.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Local (`supabase start`): the CLI prints all three on startup.
# Hosted project: Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. Bypasses RLS. Imported only by scripts/ — never by anything
# under src/app. Never log it, never paste it into a tracked file.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# The single local user
# ---------------------------------------------------------------------------
# There is no auth UI. `npm run seed:user` creates this user, and the app signs
# in as them on the server so RLS is genuinely exercised on every request.
# MONADIC_USER_ID must be a uuid you choose and then leave alone — it is the
# user_id on every row you own.
MONADIC_USER_ID=
MONADIC_USER_EMAIL=
MONADIC_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Resume parsing
# ---------------------------------------------------------------------------
# Server-side only. Used by the ResumeParser implementation to turn an uploaded
# resume into the structured profile. Never exposed to the browser.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# Sent on every outbound request to an ATS. Use a real, identifying UA with a
# contact address — this is the "respect the sources" requirement.
INGEST_USER_AGENT=
# Max concurrent board fetches. Keep this low.
INGEST_CONCURRENCY=2
