# monadic — environment contract
#
# Copy to .env.local and fill in. .env.local is gitignored and holds real
# secrets; this file must never contain a real credential.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Dashboard -> Project Settings -> API Keys.
#
# Supabase replaced the old JWT key pair in 2025. The publishable key is the
# direct replacement for the former anon key: safe in the browser, RLS applies.
# Do not enable the legacy anon / service_role JWTs on the Legacy tab.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...), the replacement for service_role. BYPASSES RLS.
# New projects do not ship one — create it under Secret keys in the dashboard.
# Imported only by scripts/ for ingestion, which writes the global tables that
# have no write policy. Never imported by anything under src/app, never logged,
# never pasted into a tracked file.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# The single local user
# ---------------------------------------------------------------------------
# There is no auth UI. `npm run seed:user` creates this user plus their
# account_profiles row, and the app signs in as them on the server so RLS is
# genuinely exercised on every request. Adding email+password or Google login
# later is a route and a form — no migration, no data-layer change.
# MONADIC_USER_ID must be a lowercase uuid you choose once and then leave alone
# — it becomes the user_id on every row you own. Generate with `uuidgen`; do not
# use a shaped value like ...0001, which invites code that depends on the shape.
MONADIC_USER_ID=
MONADIC_USER_EMAIL=
MONADIC_USER_PASSWORD=

# Your name, for the account_profiles row seed:user creates. Distinct from the
# name parsed out of your resume, which lives in public.profiles.
MONADIC_USER_FIRST_NAME=
MONADIC_USER_LAST_NAME=

# ---------------------------------------------------------------------------
# The gate
# ---------------------------------------------------------------------------
# One shared password, checked in middleware in front of every route including
# /api/*. It exists because there are no accounts: the app signs in to Supabase
# as the single user above, so an unprotected public URL hands whoever finds it
# a parsed resume and a delete button.
#
# Only enforced outside development, so a laptop needs nothing here. In
# production an unset value is fatal rather than permissive — every route
# answers 503 — because the failure mode of the alternative is publishing
# personal data. See DEPLOY.md.
MONADIC_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Resume parsing
# ---------------------------------------------------------------------------
# Server-side only. Used by the ResumeParser implementation to turn an uploaded
# resume into the structured profile. Never exposed to the browser.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# Sent on every outbound request to an ATS. Identify yourself and give an admin
# a way to reach you instead of silently blocking you. Node's default UA is
# empty or "node", which is what gets blocked.
#   monadic/0.1 (personal job search; +mailto:you@example.com)
INGEST_USER_AGENT=

# Global cap on simultaneous board fetches. Keep it at 2. Twenty companies at
# roughly a second each finishes in about ten seconds serially, so there is no
# speed problem to solve, and low concurrency is most of what separates a polite
# client from one that trips rate limiting.
INGEST_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Gmail drafts (optional)
# ---------------------------------------------------------------------------
# Leave both blank and everything still works — the compose panel falls back to
# opening your mail client, and the profile page says why the button is absent.
#
# With them set, monadic can send from your address or save to your Gmail
# drafts. The scope is gmail.compose, which Google defines as managing drafts
# AND sending; gmail.send is not requested because it would widen nothing. Every
# send goes through a review screen first. See DEPLOY.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
